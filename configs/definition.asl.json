{
    "Comment": "Complete ETL to ML Training Pipeline",
    "StartAt": "RunETL",
    "States": {
        "RunETL": {
            "Type": "Task",
            "Resource": "arn:aws:states:::glue:startJobRun.sync",
            "Parameters": {
                "JobName": "${glue_job_name}",
                "Arguments": {
                    "--INPUT_BUCKET": "s3://${project_prefix}-processed-zone",
                    "--OUTPUT_BUCKET": "s3://${s3_bucket_name}/processed/"
                }
            },
            "Next": "TrainModel"
        },
        "TrainModel": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
            "Parameters": {
                "TrainingJobName": "crop-model-training",
                "RoleArn": "${sagemaker_role_arn}",
                "AlgorithmSpecification": {
                    "TrainingImage": "${training_image}",
                    "TrainingInputMode": "File"
                },
                "InputDataConfig": [
                    {
                        "ChannelName": "train",
                        "DataSource": {
                            "S3DataSource": {
                                "S3DataType": "S3Prefix",
                                "S3Uri": "s3://${s3_bucket_name}/processed/",
                                "S3DataDistributionType": "FullyReplicated"
                            }
                        }
                    }
                ],
                "OutputDataConfig": {
                    "S3OutputPath": "s3://${s3_bucket_name}/models/"
                },
                "ResourceConfig": {
                    "InstanceType": "${instance_type}",
                    "InstanceCount": 1,
                    "VolumeSizeInGB": 50
                },
                "StoppingCondition": {
                    "MaxRuntimeInSeconds": 7200
                }
            },
            "End": true
        }
    }
}